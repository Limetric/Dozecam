<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!--
            Seeding entry point for the local RTSP testbed (tools/testbed.sh),
            dev flavor only — the production manifest never merges this in.
            Exported so `adb shell am broadcast` (the shell uid) can reach it;
            the worst a co-installed app could do with it is add rtsp:// rows
            to the dev build's camera list, which the settings screen can
            remove again.
        -->
        <receiver
            android:name="app.dozecam.dev.TestbedSeedReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver" />
    </application>

</manifest>
