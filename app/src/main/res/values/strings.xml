    <string name="viewer_listen_on">Play every camera aloud</string>
    <!--
        Listen mode assumes an awake listener, so the alarm stays quiet while a
        room is aloud. Said here, at the moment of switching it on, because it
        is the one promise a parent going to sleep must not rely on.
    -->
    <!--
        The same switch, for rooms the monitor cannot carry into the dark — a
        camera it has no way to listen to, or a monitor that never started.
        Says only what is true: aloud on this screen, and no further.
    -->
    <string name="viewer_all_aloud_on_screen">%1$s is playing aloud while this screen is on</string>
    <string name="viewer_all_aloud_on_screen_rooms">%1$d cameras are playing aloud while this screen is on</string>
    <string name="viewer_listen_on_confirmed">%1$s is playing aloud, and keeps playing with the screen off. Alerts stay quiet while you are listening.</string>
    <!--
        Several rooms out of one speaker cannot say which one a cry came from,
        so the alert does — with the screen only, never the alarm.
    -->
    <string name="viewer_listen_on_confirmed_rooms">%1$d rooms are playing aloud, and keep playing with the screen off. Alerts stay quiet, but light the screen to say which room.</string>
    <string name="viewer_listen_refused">Something else is using the speaker — nothing is playing aloud</string>
