<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      DayNight so the window behind Compose follows the user's own light/dark
      setting; anything fixed flashes the wrong shade before the first frame.
    -->
    <style name="Theme.Dozecam" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
